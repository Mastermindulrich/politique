[{"id":1,"slug":"abobo","name":"Abobo","department":"Abidjan","region":"District autonome d'Abidjan","district":"Abidjan","tagline":"La commune qui ne dort jamais, et le premier musée d'art contemporain du pays","intro":"Deuxième commune la plus peuplée du district d'Abidjan, Abobo est née autour d'une des premières gares de la ligne Abidjan-Niger. Son nom viendrait de l'ébrié « a bor bor ». C'est une ville de commerçants, d'artisans et de transporteurs, à la lisière de la forêt du Banco.","highlights":[{"k":"culture","t":"Le MuCAT","d":"Le musée des cultures contemporaines Adama Toungara, inauguré en mars 2020 sur 3 500 m² au centre-ville, est le premier musée consacré à l'art contemporain en Côte d'Ivoire."},{"k":"economie","t":"Une ville de commerce et d'ateliers","d":"Plus de huit actifs sur dix travaillent dans le commerce, le transport et l'artisanat : ferronniers, couturiers, braiseurs et vendeuses font l'énergie de la commune.","photo":1},{"k":"site","t":"La gare d'Abobo","d":"La commune a grandi autour de sa gare, sur la ligne de chemin de fer qui relie Abidjan à Ouagadougou."},{"k":"culture","t":"Les villages ébriés","d":"Abobo-Té, Abobo-Baoulé et Anonkoi-Kouté sont les villages d'origine, dont les terres ont donné naissance à la commune."}],"products":["Commerce","Artisanat","Transport","Viande braisée"],"events":[],"photos":[{"file":"Fichier:Des vendeuses ambulante.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a0/Des_vendeuses_ambulante.jpg/1280px-Des_vendeuses_ambulante.jpg?utm_source=fr.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Des_vendeuses_ambulante.jpg","artist":"SYLLA Cheick 225","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","caption":"Vendeuses au marché d'Abobo","width":6016,"height":4016},{"file":"Fichier:Le ferronnier d'abobo.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/44/Le_ferronnier_d%27abobo.jpg/1280px-Le_ferronnier_d%27abobo.jpg?utm_source=fr.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Le_ferronnier_d%27abobo.jpg","artist":"SYLLA Cheick 225","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","caption":"Un ferronnier dans son atelier","width":6016,"height":4016},{"file":"Fichier:Mairie Abobo.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0f/Mairie_Abobo.jpg/1280px-Mairie_Abobo.jpg?utm_source=fr.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Mairie_Abobo.jpg","artist":"Attreman","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","caption":"La mairie d'Abobo","width":4160,"height":2080},{"file":"Fichier:Le braiseur de viande d'abobo.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8e/Le_braiseur_de_viande_d%27abobo.jpg/1280px-Le_braiseur_de_viande_d%27abobo.jpg?utm_source=fr.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Le_braiseur_de_viande_d%27abobo.jpg","artist":"SYLLA Cheick 225","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","caption":"Un braiseur de viande","width":6016,"height":4016}],"population":{"value":1340083,"year":"2021"},"coords":{"lat":5.43333,"lon":-4.01667},"sources":[{"l":"Wikipédia : Abobo","u":"https://fr.wikipedia.org/wiki/Abobo"},{"l":"Wikidata (population)","u":"https://www.wikidata.org/wiki/Q322624"}],"featured":true},{"id":2,"slug":"adjame","name":"Adjamé","department":"Abidjan","region":"District autonome d'Abidjan","district":"Abidjan","tagline":"« La rencontre » : le grand marché d'Abidjan et la porte de tout le pays","intro":"Adjamé signifie « la rencontre » ou « le centre » en tchaman. C'est la plus ancienne souche abidjanaise, le plus grand centre commercial de la ville et le point de départ des cars vers toute la Côte d'Ivoire et la sous-région.","highlights":[{"k":"economie","t":"Une vingtaine de marchés","d":"C'est d'Adjamé que part l'essentiel des vivres qui nourrissent Abidjan. La commune compte une vingtaine de marchés, dont le Black market et trois grandes structures de vente en gros.","photo":0},{"k":"site","t":"Le boulevard Nangui Abrogoua","d":"Une des artères les plus fréquentées du pays. Elle porte le nom du chef ébrié qui défendit les droits fonciers des Djemian face à l'administration coloniale.","photo":4},{"k":"economie","t":"La plus grande gare routière du pays","d":"Les lignes de cars et de bus partent d'ici vers toutes les régions et vers les pays voisins.","photo":1},{"k":"site","t":"Les 220 Logements","d":"Un quartier historique aux bâtiments rénovés, autour du rond-point Liberté.","photo":3}],"products":["Vivriers","Poisson et crevettes","Textile","Commerce de gros"],"events":[],"photos":[{"file":"Fichier:Black market d'Adjamé.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/93/Black_market_d%27Adjam%C3%A9.jpg/1280px-Black_market_d%27Adjam%C3%A9.jpg?utm_source=fr.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Black_market_d%27Adjam%C3%A9.jpg","artist":"MamadouKO-Mam","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","caption":"Le Black market d'Adjamé","width":4080,"height":3060},{"file":"Fichier:La gare nord d'Adjamé vu d'en haut.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2a/La_gare_nord_d%27Adjam%C3%A9_vu_d%27en_haut.jpg/1280px-La_gare_nord_d%27Adjam%C3%A9_vu_d%27en_haut.jpg?utm_source=fr.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:La_gare_nord_d%27Adjam%C3%A9_vu_d%27en_haut.jpg","artist":"MamadouKO-Mam","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","caption":"La gare nord, vue d'en haut","width":4080,"height":3060},{"file":"Fichier:Étale de produits viviers.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/88/%C3%89tale_de_produits_viviers.jpg/1280px-%C3%89tale_de_produits_viviers.jpg?utm_source=fr.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:%C3%89tale_de_produits_viviers.jpg","artist":"Axel toualy","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","caption":"Étal de produits vivriers","width":1920,"height":1280},{"file":"Fichier:Les bâtiments des 220 logements à Adjamé.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/93/Les_b%C3%A2timents_des_220_logements_%C3%A0_Adjam%C3%A9.jpg/1280px-Les_b%C3%A2timents_des_220_logements_%C3%A0_Adjam%C3%A9.jpg?utm_source=fr.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Les_b%C3%A2timents_des_220_logements_%C3%A0_Adjam%C3%A9.jpg","artist":"MamadouKO-Mam","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","caption":"Les 220 Logements","width":2576,"height":1932},{"file":"Fichier:Magasin de vêtements dans la commune d'Adjamé.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5c/Magasin_de_v%C3%AAtements_dans_la_commune_d%27Adjam%C3%A9.jpg/1280px-Magasin_de_v%C3%AAtements_dans_la_commune_d%27Adjam%C3%A9.jpg?utm_source=fr.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Magasin_de_v%C3%AAtements_dans_la_commune_d%27Adjam%C3%A9.jpg","artist":"MamadouKO-Mam","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","caption":"Boulevard Nangui Abrogoua","width":2576,"height":1932},{"file":"Fichier:Rond-point Liberté Adjamé.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/34/Rond-point_Libert%C3%A9_Adjam%C3%A9.jpg/1280px-Rond-point_Libert%C3%A9_Adjam%C3%A9.jpg?utm_source=fr.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Rond-point_Libert%C3%A9_Adjam%C3%A9.jpg","artist":"Willy Stephane Awaho","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0","caption":"Le rond-point Liberté","width":1600,"height":1200}],"population":{"value":340892,"year":"2021"},"coords":{"lat":5.48806,"lon":-4.03222},"sources":[{"l":"Wikipédia : Adjamé","u":"https://fr.wikipedia.org/wiki/Adjam%C3%A9"},{"l":"Wikidata (population)","u":"https://www.wikidata.org/wiki/Q357695"}],"featured":true},{"id":3,"slug":"attecoube","name":"Attécoubé","department":"Abidjan","region":"District autonome d'Abidjan","district":"Abidjan","tagline":"Entre la forêt du Banco et la lagune, le poumon vert d'Abidjan","intro":"Posée sur une butte qui domine la baie du Banco, Attécoubé (« le village en bas ») abrite la totalité du parc national du Banco. Sur ses 68 km², 40 sont couverts de forêt et 5 de lagune.","highlights":[{"k":"nature","t":"Le parc national du Banco","d":"3 000 hectares de forêt primaire en pleine ville, entièrement sur le territoire de la commune."},{"k":"site","t":"Le Sanctuaire marial national","d":"Le sanctuaire Notre-Dame d'Afrique, lieu de pèlerinage national, domine la lagune.","photo":0},{"k":"site","t":"Abobo-Doumé et Lokodjro","d":"Deux villages atchan au bord de l'eau : un port de pêche artisanale et la gare lagunaire d'où partent les bateaux-bus vers le Plateau.","photo":2},{"k":"economie","t":"La mémoire du bois","d":"Au début du siècle dernier, les grumes d'acajou, de niangon et de samba transitaient ici par la lagune avant d'embarquer pour l'Europe."}],"products":["Pêche artisanale","Bois"],"events":[],"photos":[{"file":"Fichier:Sanctuaire Marial national de Côte d'Ivoire 07.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/49/Sanctuaire_Marial_national_de_C%C3%B4te_d%27Ivoire_07.jpg/1280px-Sanctuaire_Marial_national_de_C%C3%B4te_d%27Ivoire_07.jpg?utm_source=fr.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Sanctuaire_Marial_national_de_C%C3%B4te_d%27Ivoire_07.jpg","artist":"Aristidek5maya","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","caption":"Le Sanctuaire marial national","width":4000,"height":1818},{"file":"Fichier:Entrée du Sanctuaire Marial d'Attécoubé.JPG","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d5/Entr%C3%A9e_du_Sanctuaire_Marial_d%27Att%C3%A9coub%C3%A9.JPG/1280px-Entr%C3%A9e_du_Sanctuaire_Marial_d%27Att%C3%A9coub%C3%A9.JPG?utm_source=fr.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Entr%C3%A9e_du_Sanctuaire_Marial_d%27Att%C3%A9coub%C3%A9.JPG","artist":"Sebastien yapo","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","caption":"L'entrée du sanctuaire","width":2304,"height":1728},{"file":"Fichier:Gare lagunaire d'Abobo-Doumé 01.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/bb/Gare_lagunaire_d%27Abobo-Doum%C3%A9_01.jpg/1280px-Gare_lagunaire_d%27Abobo-Doum%C3%A9_01.jpg?utm_source=fr.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Gare_lagunaire_d%27Abobo-Doum%C3%A9_01.jpg","artist":"Aristidek5maya","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","caption":"La gare lagunaire d'Abobo-Doumé","width":4000,"height":1818},{"file":"Fichier:Sanctuaire Marial national de Côte d'Ivoire 06.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/ca/Sanctuaire_Marial_national_de_C%C3%B4te_d%27Ivoire_06.jpg/1280px-Sanctuaire_Marial_national_de_C%C3%B4te_d%27Ivoire_06.jpg?utm_source=fr.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Sanctuaire_Marial_national_de_C%C3%B4te_d%27Ivoire_06.jpg","artist":"Aristidek5maya","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","caption":"Dans l'enceinte du sanctuaire","width":4000,"height":1818}],"population":{"value":313135,"year":"2021"},"coords":{"lat":5.333732,"lon":-4.037862},"sources":[{"l":"Wikipédia : Attécoubé","u":"https://fr.wikipedia.org/wiki/Att%C3%A9coub%C3%A9"},{"l":"Wikidata (population)","u":"https://www.wikidata.org/wiki/Q2869932"}]},{"id":4,"slug":"cocody","name":"Cocody","department":"Abidjan","region":"District autonome d'Abidjan","district":"Abidjan","tagline":"Universités, ambassades et Hôtel Ivoire : la commune du savoir et des grandes adresses","intro":"Cocody est l'un des tout premiers villages ébriés d'Abidjan. Elle accueille aujourd'hui l'université, de grands hôpitaux et le célèbre Hôtel Ivoire, et elle a inspiré un film et une chanson d'Alpha Blondy.","highlights":[{"k":"site","t":"L'Hôtel Ivoire","d":"Le Sofitel Ivoire, entièrement rénové en 2011, a longtemps été le seul hôtel d'Afrique à posséder une patinoire."},{"k":"artisanat","t":"Le marché N'Goan Aka Mathias","d":"Sur trois étages, le marché couvert de Cocody rassemble l'artisanat de toute l'Afrique de l'Ouest."},{"k":"economie","t":"Pôle de santé et de recherche","d":"L'Institut Pasteur de Côte d'Ivoire (1972), le CHU de Cocody et la PISAM, dont le plateau technique est l'un des plus modernes de la sous-région."},{"k":"culture","t":"Cocody à l'écran et en musique","d":"« Le Gentleman de Cocody » (1964), avec Jean Marais, et « Cocody Rock » d'Alpha Blondy portent le nom de la commune."},{"k":"culture","t":"Les villages ébriés","d":"Blockauss, Danga et les autres villages tchaman rappellent que Cocody est née au bord de la lagune."}],"products":["Artisanat","Enseignement supérieur","Santé"],"events":[],"photos":[{"file":"Fichier:Mairiecocody.JPG","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/22/Mairiecocody.JPG/1280px-Mairiecocody.JPG?utm_source=fr.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Mairiecocody.JPG","artist":"Zenman","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","caption":"L'hôtel communal de Cocody","width":3544,"height":2440}],"population":{"value":692583,"year":"2021"},"coords":{"lat":5.356256,"lon":-3.9825439},"sources":[{"l":"Wikipédia : Cocody","u":"https://fr.wikipedia.org/wiki/Cocody"},{"l":"Wikidata (population)","u":"https://www.wikidata.org/wiki/Q1105423"}],"featured":true},{"id":5,"slug":"koumassi","name":"Koumassi","department":"Abidjan","region":"District autonome d'Abidjan","district":"Abidjan","tagline":"Une presqu'île sur la lagune, capitale du poisson braisé","intro":"Sur l'île de Petit-Bassam, Koumassi est une presqu'île de 874 hectares bordée par la lagune Ébrié. Son grand carrefour est l'un des plus larges boulevards d'Abidjan.","highlights":[{"k":"saveurs","t":"Poisson et poulet braisés","d":"Kedjenou de poulet, poisson braisé et ses condiments : les maquis de Koumassi sont une adresse pour qui aime la cuisine ivoirienne.","photo":1},{"k":"economie","t":"Le marché de Koumassi","d":"Le grand marché rythme la vie de la commune, avec ses bouchers, ses vivriers et ses étals.","photo":2},{"k":"nature","t":"Une façade lagunaire","d":"La lagune Ébrié borde la commune au nord-est et au sud-est."}],"products":["Poisson braisé","Kedjenou","Commerce"],"events":[],"photos":[{"file":"Fichier:Photograph of the 3D text I LOVE KOUMASSI 03.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d2/Photograph_of_the_3D_text_I_LOVE_KOUMASSI_03.jpg/1280px-Photograph_of_the_3D_text_I_LOVE_KOUMASSI_03.jpg?utm_source=fr.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Photograph_of_the_3D_text_I_LOVE_KOUMASSI_03.jpg","artist":"Kod B","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","caption":"« J'aime Koumassi »","width":4064,"