# Public origin of the site (canonical URLs, Open Graph, links in auth emails)
SITE_URL=https://politique.prototypex.org
# Set to /politique only if the site is served under prototypex.org/politique
NEXT_PUBLIC_BASE_PATH=

# --- Supabase (the app shows a "not connected" notice until both are set) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Needed for "delete my account". Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Set to 1 to open sign-ups and show the Log in / Create account buttons on the landing page
NEXT_PUBLIC_BETA_OPEN=
# Address shown on the rules and privacy pages
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Waitlist (Resend audience). Both optional: without them, sign-ups are logged only. ---
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
# Optional: notify this address on each sign-up (needs a verified Resend sender)
WAITLIST_NOTIFY_TO=
WAITLIST_FROM=POLITIQUE <no-reply@prototypex.org>
