# Public origin of the site (canonical URLs, Open Graph, links in auth emails)
SITE_URL=https://politique.prototypex.org
# Set to /politique only if the site is served under prototypex.org/politique
NEXT_PUBLIC_BASE_PATH=

# --- Supabase (the app shows a maintenance notice until both are set) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Needed for "delete my account". Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Server only. When set (with the service key), login codes are emailed by POLITIQUE itself
# through Resend, as "POLITIQUE" <politique@prototypex.org>, instead of the shared Supabase mailer.
RESEND_API_KEY=
# Optional override of the sender
AUTH_EMAIL_FROM=

# Address shown on the rules and privacy pages
NEXT_PUBLIC_CONTACT_EMAIL=
